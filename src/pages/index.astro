---
import Layout from '~/layouts/PageLayout.astro';

import Hero from '~/components/widgets/Hero.astro';
import Features from '~/components/widgets/Features.astro';
import Content from '~/components/widgets/Content.astro';
import FAQs from '~/components/widgets/FAQs.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';

const metadata = {
  title: 'PT Surya Satu Bersama — Lighting & Technology Solutions',
  description:
    'PT Surya Satu Bersama provides integrated lighting, technology, IT, IoT, software, distribution and energy solutions through Aruna and Unisolve.',
  ignoreTitleTemplate: true,
};
---

<Layout metadata={metadata}>

  <!-- ========================================================= -->
  <!-- HERO -->
  <!-- ========================================================= -->

  <Hero
    actions={[
      {
        variant: 'primary',
        text: 'Explore Our Solutions',
        href: '#solutions',
      },
      {
        text: 'Contact Us',
        href: '#contact',
      },
    ]}
    image={{
      src: '~/assets/images/hero-image.png',
      alt: 'Surya Satu Bersama Solutions',
    }}
  >
    <Fragment slot="title">
      Building a
      <span class="text-accent dark:text-white">
        Brighter & Smarter
      </span>
      Future
    </Fragment>

    <Fragment slot="subtitle">
      <span class="font-semibold">PT Surya Satu Bersama</span>
      delivers integrated solutions across lighting, technology,
      IT, IoT, software, distribution and energy.
    </Fragment>
  </Hero>


  <!-- ========================================================= -->
  <!-- ABOUT -->
  <!-- ========================================================= -->

  <Content
    isReversed
    tagline="PT SURYA SATU BERSAMA"
    title="Solutions that connect light, technology and opportunity."
    items={[
      {
        title: 'Integrated Solutions',
        description:
          'We bring together products, technology and practical solutions to address the evolving needs of businesses, institutions and communities.',
      },
      {
        title: 'Two Specialized Brands',
        description:
          'Aruna focuses on lighting solutions, while Unisolve delivers technology, IT, IoT, software, distribution and energy solutions.',
      },
      {
        title: 'Built for Real Applications',
        description:
          'Our approach combines reliable products with practical implementation, creating solutions designed for real-world environments.',
      },
    ]}
    image={{
      src: 'https://images.unsplash.com/photo-1497366811353-6870744d04b2?auto=format&fit=crop&w=2070&q=80',
      alt: 'Modern business environment',
    }}
  >
    <Fragment slot="content">
      <h3 class="text-2xl font-bold tracking-tight dark:text-white sm:text-3xl mb-2">
        One company. Multiple capabilities.
      </h3>

      <p>
        PT Surya Satu Bersama is built around a simple idea:
        combining dependable products with technology and practical
        solutions to create long-term value.
      </p>
    </Fragment>

    <Fragment slot="bg">
      <div class="absolute inset-0 bg-blue-50 dark:bg-transparent"></div>
    </Fragment>
  </Content>


  <!-- ========================================================= -->
  <!-- OUR BRANDS -->
  <!-- ========================================================= -->

  <Features
    id="brands"
    tagline="OUR BRANDS"
    title="Two brands. One integrated vision."
    subtitle="Our brands focus on different areas while working together to deliver broader solutions."
    items={[
      {
        title: 'ARUNA',
        description:
          'Lighting solutions for indoor and outdoor environments, designed to deliver reliable illumination, efficiency and practical value.',
        icon: 'tabler:bulb',
      },
      {
        title: 'UNISOLVE',
        description:
          'Technology and digital solutions covering IT infrastructure, IoT, software, technology distribution and energy solutions.',
        icon: 'tabler:device-desktop',
      },
    ]}
  />


  <!-- ========================================================= -->
  <!-- ARUNA -->
  <!-- ========================================================= -->

  <Content
    isAfterContent
    tagline="ARUNA"
    title="Lighting solutions for a brighter environment."
    items={[
      {
        title: 'Indoor Lighting',
        description:
          'Lighting solutions for offices, commercial spaces, residential environments and institutional applications.',
      },
      {
        title: 'Outdoor Lighting',
        description:
          'Solutions for streets, public areas, facilities, commercial environments and outdoor applications.',
      },
      {
        title: 'Practical & Efficient',
        description:
          'Products designed with attention to performance, reliability, energy efficiency and application requirements.',
      },
      {
        title: 'Made for Real Needs',
        description:
          'Aruna focuses on delivering lighting products and solutions that are practical, scalable and adaptable.',
      },
    ]}
    image={{
      src: 'https://images.unsplash.com/photo-1497366754035-f200968a6e72?auto=format&fit=crop&w=2194&q=80',
      alt: 'Modern interior lighting',
    }}
  >
    <Fragment slot="content">
      <h3 class="text-2xl font-bold tracking-tight dark:text-white sm:text-3xl mb-2">
        ARUNA — Lighting
      </h3>

      <p>
        From indoor spaces to outdoor environments, Aruna is focused
        on creating lighting solutions that combine performance,
        functionality and visual comfort.
      </p>
    </Fragment>

    <Fragment slot="bg">
      <div class="absolute inset-0 bg-blue-50 dark:bg-transparent"></div>
    </Fragment>
  </Content>


  <!-- ========================================================= -->
  <!-- UNISOLVE -->
  <!-- ========================================================= -->

  <Content
    isReversed
    isAfterContent
    tagline="UNISOLVE"
    title="Technology that solves real business challenges."
    items={[
      {
        title: 'IT Infrastructure',
        description:
          'Infrastructure solutions designed to support reliable, secure and scalable business operations.',
      },
      {
        title: 'IoT',
        description:
          'Connected devices and IoT solutions that help organizations monitor, manage and optimize operations.',
      },
      {
        title: 'Software',
        description:
          'Software and digital solutions designed around operational requirements and business workflows.',
      },
      {
        title: 'Energy & Distribution',
        description:
          'Technology distribution and energy-related solutions supporting modern business and infrastructure needs.',
      },
    ]}
    image={{
      src: 'https://images.unsplash.com/photo-1518770660439-4636190af475?auto=format&fit=crop&w=2070&q=80',
      alt: 'Technology and digital infrastructure',
    }}
  >
    <Fragment slot="content">
      <h3 class="text-2xl font-bold tracking-tight dark:text-white sm:text-3xl mb-2">
        UNISOLVE — Technology
      </h3>

      <p>
        Unisolve brings technology, IT infrastructure, IoT, software,
        distribution and energy capabilities together to help
        organizations operate smarter.
      </p>
    </Fragment>

    <Fragment slot="bg">
      <div class="absolute inset-0 bg-blue-50 dark:bg-transparent"></div>
    </Fragment>
  </Content>


  <!-- ========================================================= -->
  <!-- SOLUTIONS -->
  <!-- ========================================================= -->

  <Features
    id="solutions"
    tagline="OUR SOLUTIONS"
    title="Capabilities designed around your needs."
    subtitle="From physical infrastructure to digital transformation, our solutions can be combined to address different environments and business requirements."
    items={[
      {
        title: 'Lighting Solutions',
        description:
          'Indoor and outdoor lighting solutions through Aruna for commercial, institutional, residential and public applications.',
        icon: 'tabler:bulb',
      },
      {
        title: 'IT Infrastructure',
        description:
          'Technology infrastructure supporting connectivity, computing, systems and business operations.',
        icon: 'tabler:server',
      },
      {
        title: 'IoT Solutions',
        description:
          'Connected systems that provide visibility, monitoring and smarter control of operational environments.',
        icon: 'tabler:antenna',
      },
      {
        title: 'Software',
        description:
          'Digital solutions that help businesses improve processes, information flow and operational efficiency.',
        icon: 'tabler:code',
      },
      {
        title: 'Energy',
        description:
          'Technology and energy solutions supporting more efficient and modern infrastructure.',
        icon: 'tabler:bolt',
      },
      {
        title: 'Distribution',
        description:
          'Technology product distribution supporting partners, businesses and project requirements.',
        icon: 'tabler:truck-delivery',
      },
    ]}
  />


  <!-- ========================================================= -->
  <!-- WHY SSB -->
  <!-- ========================================================= -->

  <Content
    isAfterContent
    tagline="WHY SSB"
    title="From products to solutions."
    items={[
      {
        title: 'Multi-Disciplinary',
        description:
          'Lighting and technology capabilities under one company create opportunities for integrated solutions.',
      },
      {
        title: 'Application Focused',
        description:
          'We focus on understanding the actual requirement before selecting products and technologies.',
      },
      {
        title: 'Flexible',
        description:
          'Our capabilities can support individual product requirements as well as broader solution projects.',
      },
      {
        title: 'Long-Term Partnership',
        description:
          'We aim to build sustainable relationships with customers, partners and technology providers.',
      },
    ]}
    image={{
      src: 'https://images.unsplash.com/photo-1556761175-b413da4baf72?auto=format&fit=crop&w=2070&q=80',
      alt: 'Business collaboration',
    }}
  >
    <Fragment slot="content">
      <h3 class="text-2xl font-bold tracking-tight dark:text-white sm:text-3xl mb-2">
        More than a product supplier.
      </h3>

      <p>
        We believe the best solutions start with understanding
        the problem. Our role is to connect products, technology
        and implementation into something that creates measurable value.
      </p>
    </Fragment>

    <Fragment slot="bg">
      <div class="absolute inset-0 bg-blue-50 dark:bg-transparent"></div>
    </Fragment>
  </Content>


  <!-- ========================================================= -->
  <!-- FAQ -->
  <!-- ========================================================= -->

  <FAQs
    id="faq"
    title="Frequently Asked Questions"
    subtitle="A few things you may want to know about PT Surya Satu Bersama and our brands."
    tagline="FAQ"
    classes={{ container: 'max-w-6xl' }}
    items={[
      {
        title: 'What is PT Surya Satu Bersama?',
        description:
          'PT Surya Satu Bersama is a company providing solutions across lighting and technology. Our brands include Aruna for lighting and Unisolve for technology-related solutions.',
      },
      {
        title: 'What is Aruna?',
        description:
          'Aruna is the lighting brand of PT Surya Satu Bersama, focusing on indoor and outdoor lighting solutions.',
      },
      {
        title: 'What is Unisolve?',
        description:
          'Unisolve is the technology brand of PT Surya Satu Bersama, covering IT, IoT, software, technology distribution and energy solutions.',
      },
      {
        title: 'Can SSB handle customized projects?',
        description:
          'Our capabilities allow us to support different project requirements. Contact our team to discuss your specific application and requirements.',
      },
      {
        title: 'Can Aruna and Unisolve solutions be combined?',
        description:
          'Yes. Because both brands operate under PT Surya Satu Bersama, lighting and technology capabilities can be considered together for suitable projects.',
      },
      {
        title: 'How can I contact SSB?',
        description:
          'You can contact PT Surya Satu Bersama through the contact information provided on this website. Our team will help direct your inquiry to the appropriate solution area.',
      },
    ]}
  />


  <!-- ========================================================= -->
  <!-- CONTACT CTA -->
  <!-- ========================================================= -->

  <CallToAction
    id="contact"
    actions={[
      {
        variant: 'primary',
        text: 'Contact Us',
        href: 'mailto:info@suryasatubersama.com',
        icon: 'tabler:mail',
      },
    ]}
  >
    <Fragment slot="title">
      Let's build something
      <span class="sm:whitespace-nowrap">better together.</span>
    </Fragment>

    <Fragment slot="subtitle">
      Talk to PT Surya Satu Bersama about your lighting,
      technology or integrated solution requirements.
    </Fragment>
  </CallToAction>

</Layout>
